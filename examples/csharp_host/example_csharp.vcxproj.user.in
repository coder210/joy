<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <!-- example_csharp is a native host; JoyGame.dll is loaded in-process by hostfxr.
         Native-only debugging does not bind managed breakpoints, so use mixed .NET Core. -->
    <LocalDebuggerDebuggerType>NativeWithManagedCore</LocalDebuggerDebuggerType>
    <LocalDebuggerWorkingDirectory>$(TargetDir)</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
</Project>
